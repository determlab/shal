{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shal.dev/schemas/shal-v1.schema.json",
  "title": "SHAL topology file, shal_version 1",
  "description": "Structural validation of a SHAL topology. Semantic checks (id uniqueness, per-bus-family address grammar, driver installed, $ref resolution, transport-kind compatibility) happen at load, after schema validation.",
  "type": "object",
  "required": ["shal_version"],
  "additionalProperties": false,
  "anyOf": [
    { "required": ["root"] },
    { "required": ["template"] },
    { "required": ["include"] }
  ],
  "properties": {
    "shal_version": { "const": 1 },
    "root": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "$ref": "#/$defs/nodeName" },
      "additionalProperties": { "$ref": "#/$defs/node" }
    },
    "template": { "$ref": "#/$defs/node" },
    "include": {
      "type": "array",
      "description": "Relative paths to other topology files. Each is a full topology with its own `root:`; their `root:` maps merge as siblings into this file's `root:` (nothing nests). A main file may be include-only (no `root:` of its own).",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "policy": {
      "type": "object",
      "description": "The operator's approval policy (ADR-001 addendum 5). `gated` lists the side effects that stop for approval; default [actuator, config]. It is the only place that may NARROW the set; host code may only widen it. Main topology file only.",
      "additionalProperties": false,
      "properties": {
        "gated": {
          "type": "array",
          "uniqueItems": true,
          "items": { "enum": ["write", "actuator", "config"] }
        }
      }
    }
  },
  "$defs": {
    "nodeName": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]*$"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]*$"
    },
    "compatible": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_.-]*,[a-z0-9][a-z0-9_.-]*$"
    },
    "address": {
      "oneOf": [
        { "type": "string", "minLength": 1 },
        { "type": "integer", "minimum": 0 }
      ]
    },
    "path": {
      "type": "string",
      "pattern": "^(/[a-z0-9][a-z0-9_-]*)+$"
    },
    "ref": {
      "type": "string",
      "pattern": "^\\$[a-z0-9][a-z0-9_-]*$"
    },
    "route": {
      "type": "object",
      "required": ["via", "address"],
      "additionalProperties": false,
      "properties": {
        "via": { "$ref": "#/$defs/path" },
        "address": { "$ref": "#/$defs/address" },
        "name": { "$ref": "#/$defs/nodeName" }
      }
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "description": { "type": "string" },
        "expose": { "type": "boolean" },
        "driver": { "$ref": "#/$defs/compatible" },
        "from": { "type": "string", "minLength": 1 },
        "address": { "$ref": "#/$defs/address" },
        "routes": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/route" }
        },
        "to": { "$ref": "#/$defs/ref" },
        "use": { "type": "string", "minLength": 1 },
        "with": {
          "type": "object",
          "additionalProperties": {
            "oneOf": [
              { "type": "string" },
              { "type": "number" },
              { "type": "boolean" }
            ]
          }
        },
        "children": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": { "$ref": "#/$defs/nodeName" },
          "additionalProperties": { "$ref": "#/$defs/node" }
        },
        "watchdog_ms": { "type": "integer", "minimum": 1 },
        "verify": { "type": "boolean" },
        "insecure": { "type": "boolean" },
        "config": {
          "type": "object",
          "description": "Bus/driver-specific parameters. String values of the form ${ENV_VAR} resolve from the environment at load (the documented home for secrets); literals are the local-file convenience. The reserved `limits` key is installation safety policy consumed by the framework, never by the driver.",
          "properties": {
            "headers": {
              "type": "object",
              "description": "shal,http: HTTP headers the BUS adds to every request (credentials live here, never in a driver). ${ENV_VAR} references resolve at bind, also inside a value (\"Bearer ${TOKEN}\"). They win over an envelope header of the same name and are never forwarded across a redirect.",
              "additionalProperties": { "type": "string" }
            },
            "limits": {
              "type": "object",
              "description": "Installation operating limits: op name -> param name -> JSON-Schema constraint fragment. May only TIGHTEN the driver's declared device limits; widening fails the load.",
              "additionalProperties": {
                "type": "object",
                "additionalProperties": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "minimum": { "type": "number" },
                    "maximum": { "type": "number" },
                    "exclusiveMinimum": { "type": "number" },
                    "exclusiveMaximum": { "type": "number" },
                    "enum": { "type": "array" }
                  }
                }
              }
            }
          },
          "additionalProperties": {
            "oneOf": [
              { "type": "string" },
              { "type": "number" },
              { "type": "boolean" }
            ]
          }
        }
      },
      "allOf": [
        {
          "comment": "A use: node draws address/routes/to from its template, so it is exempt from the one-of-those constraint that ordinary nodes obey. A routed node has both address (its main route, under its parent bus) and routes (the jumps); routes without address is invalid.",
          "if": { "not": { "required": ["use"] } },
          "then": {
            "oneOf": [
              { "required": ["address"], "not": { "anyOf": [{ "required": ["routes"] }, { "required": ["to"] }] } },
              { "required": ["routes"], "allOf": [{ "required": ["address"] }], "not": { "required": ["to"] } },
              { "required": ["to"], "not": { "anyOf": [{ "required": ["address"] }, { "required": ["routes"] }, { "required": ["children"] }] } }
            ]
          }
        }
      ]
    }
  }
}
